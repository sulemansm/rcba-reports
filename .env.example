# ─────────────────────────────────────────────────────────────────────────────
# RCBA Event Reporter — Environment Variables
# Copy these into Render → Service → Environment, or into .env for local dev.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Paste the ENTIRE contents of your downloaded google_credentials.json here as one line:
GOOGLE_CREDENTIALS_JSON={"web":{"client_id":"...","client_secret":"...","redirect_uris":["..."],...}}

# OAuth redirect URI — must match what you added in Google Cloud Console
# For Render: https://your-app-name.onrender.com/
# For local:  http://localhost:8501/
OAUTH_REDIRECT_URI=https://your-app-name.onrender.com/

# ── Authorised members ────────────────────────────────────────────────────────
# Comma-separated list of Google email addresses allowed to sign in
WHITELISTED_EMAILS=admin@example.com,secretary@example.com,member@example.com

# ── Email (Gmail App Password) ────────────────────────────────────────────────
SENDER_EMAIL=yourapp@gmail.com
# 16-character App Password from myaccount.google.com/apppasswords (no spaces):
SENDER_PASSWORD=abcdabcdabcdabcd
SECRETARY_EMAIL=secretary@example.com

# ── Groq AI (report generation) ───────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
